# Required: dashboard login password and session signing key (>=16 chars)
DASHBOARD_PASSWORD=change-me
SECRET_KEY=generate-with-python-secrets-token_hex-32
# AssetTrade BOT_API_KEY (from /opt/assettrade/.env) — only needed for futures pause/resume
ASSETTRADE_API_KEY=
PORT=8200
HOST=0.0.0.0
# Optional overrides: FUTURES_DB, POLY_PORTFOLIO, FOREX_DB, FOREX_DIR, POLY_CRON_JOB, HUB_DB, SNAPSHOT_INTERVAL
