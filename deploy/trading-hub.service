[Unit]
Description=Trading Hub unified dashboard (port 8200)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading-hub
ExecStart=/home/ubuntu/trading-hub/.venv/bin/uvicorn src.app:app --host 0.0.0.0 --port 8200 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
